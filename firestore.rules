rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidScanItem(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.riskLevel in ['HIGH_RISK', 'SUSPICIOUS', 'SAFE_VERIFIED', 'UNABLE_TO_VERIFY'];
    }

    function isValidTrustedContact(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() > 0 && data.phoneNumber.size() <= 30;
    }

    function isValidQuizProgress(data) {
      return data.userId == request.auth.uid &&
             data.quizId is string && data.quizId.size() > 0 && data.quizId.size() <= 50;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /scans/{scanId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidScanItem(request.resource.data);
      }

      match /trustedContacts/{contactId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTrustedContact(request.resource.data);
      }

      match /quizProgress/{progressId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidQuizProgress(request.resource.data);
      }
    }
  }
}
